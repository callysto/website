---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resources, typeConfig, subjectConfig } from '../data/resources.js';

const typeFilters = [
  { key: 'all', label: 'All' },
  { key: 'learning-module', label: 'Learning Modules' },
  { key: 'data-viz', label: 'Data Viz' },
  { key: 'ai-course', label: 'AI Course' },
  { key: 'hackathon', label: 'Hackathon' },
  { key: 'lesson-plan', label: 'Lesson Plans' },
  { key: 'interesting-problem', label: 'Interesting Problems' },
  { key: 'data-lab', label: 'Data Labs' },
];

const subjectFilters = [
  { key: 'all', label: 'All subjects' },
  { key: 'math', label: 'Math' },
  { key: 'science', label: 'Science' },
  { key: 'english', label: 'English' },
  { key: 'social-studies', label: 'Social Studies' },
  { key: 'technology', label: 'Technology' },
  { key: 'indigenous', label: 'Indigenous' },
  { key: 'health', label: 'Health' },
  { key: 'ai', label: 'AI & Data Science' },
];

const total = resources.length;
---

<BaseLayout title="Callysto — Bring data science into your classroom">

  <!-- Nav -->
  <header style="position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: rgba(8,12,26,0.9); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(79,142,247,0.12);">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; height: 64px; display: flex; align-items: center; justify-content: space-between;">
      <a href="/" style="font-family: var(--font-family-display); font-weight: 700; font-size: 1.25rem; color: var(--color-cloud); text-decoration: none; letter-spacing: -0.02em;">Callysto</a>
      <nav style="display: flex; gap: 2rem; align-items: center;">
        <a href="#about" style="color: var(--color-dust); text-decoration: none; font-size: 0.9rem;" onmouseover="this.style.color='var(--color-cloud)'" onmouseout="this.style.color='var(--color-dust)'">About</a>
        <a href="#contact" style="color: var(--color-dust); text-decoration: none; font-size: 0.9rem;" onmouseover="this.style.color='var(--color-cloud)'" onmouseout="this.style.color='var(--color-dust)'">Contact</a>
        <a href="#resources" style="background: var(--color-callisto); color: #fff; text-decoration: none; font-size: 0.875rem; font-weight: 600; padding: 0.5rem 1.25rem; border-radius: 6px;" onmouseover="this.style.background='var(--color-callisto-light)'" onmouseout="this.style.background='var(--color-callisto)'">Explore resources</a>
      </nav>
    </div>
  </header>

  <!-- Hero (compact) -->
  <section style="
    min-height: 65vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(79,142,247,0.12) 0%, transparent 60%),
                radial-gradient(ellipse 60% 40% at 80% 80%, rgba(124,77,255,0.08) 0%, transparent 50%),
                var(--color-space-950);
  ">
    <!-- Starfield -->
    <div aria-hidden="true" style="
      position: absolute; inset: 0; overflow: hidden; pointer-events: none;
      background-image:
        radial-gradient(1px 1px at 10% 20%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 30% 5%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 50% 15%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 70% 8%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 85% 25%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 20% 40%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 40% 55%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 60% 35%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 75% 60%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 90% 45%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 15% 70%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1.5px 1.5px at 35% 80%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 55% 75%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(1px 1px at 80% 85%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(2px 2px at 25% 90%, rgba(79,142,247,0.6) 0%, transparent 100%),
        radial-gradient(2px 2px at 65% 92%, rgba(124,77,255,0.5) 0%, transparent 100%);
    "></div>
    <!-- Orbital rings -->
    <div aria-hidden="true" style="position: absolute; right: -10%; top: 50%; transform: translateY(-50%); width: 520px; height: 520px; border-radius: 50%; border: 1px solid rgba(79,142,247,0.07); pointer-events: none;"></div>
    <div aria-hidden="true" style="position: absolute; right: -4%; top: 50%; transform: translateY(-50%); width: 360px; height: 360px; border-radius: 50%; border: 1px solid rgba(124,77,255,0.09); pointer-events: none;"></div>

    <div style="max-width: 1200px; margin: 0 auto; padding: 6rem 1.5rem 3.5rem; position: relative; z-index: 1; width: 100%;">
      <div style="max-width: 700px;">
        <!-- Eyebrow -->
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(79,142,247,0.1); border: 1px solid rgba(79,142,247,0.2); border-radius: 100px; padding: 0.375rem 1rem; margin-bottom: 1.75rem;">
          <span style="width: 6px; height: 6px; background: var(--color-callisto); border-radius: 50%; display: inline-block;"></span>
          <span style="font-size: 0.8rem; color: var(--color-callisto); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase;">Free for Canadian K–12</span>
        </div>

        <h1 style="font-family: var(--font-family-display); font-size: clamp(2.5rem, 6vw, 4.25rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.03em; color: var(--color-cloud); margin: 0 0 1.25rem;">
          Bring data science<br />
          <span style="background: linear-gradient(135deg, var(--color-callisto), var(--color-nebula)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">into your classroom</span>
        </h1>

        <p style="font-size: clamp(1rem, 2vw, 1.2rem); color: var(--color-dust); line-height: 1.7; margin: 0 0 2rem; max-width: 540px;">
          {total}+ free, interactive learning resources for Grades 5–12.
          No account needed — open in any modern browser and start exploring today.
        </p>

        <div style="display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; margin-bottom: 3rem;">
          <a href="#resources" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-callisto); color: #fff; text-decoration: none; font-weight: 600; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px;" onmouseover="this.style.background='var(--color-callisto-light)'" onmouseout="this.style.background='var(--color-callisto)'">
            Explore resources
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="https://callysto.github.io/jupyterlite/lab?path=hackathon%2FPok%C3%A9mon%2Fpokemon-intro.ipynb" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 0.5rem; border: 1px solid rgba(245,200,66,0.4); color: var(--color-stellar); text-decoration: none; font-weight: 500; font-size: 1rem; padding: 0.875rem 2rem; border-radius: 8px;" onmouseover="this.style.borderColor='rgba(245,200,66,0.8)'" onmouseout="this.style.borderColor='rgba(245,200,66,0.4)'">
            ⚡ Try Pokémon challenge
          </a>
        </div>

        <!-- Impact stats inline -->
        <div style="display: flex; flex-wrap: wrap; gap: 2.5rem;">
          {[
            { value: '160K+', label: 'Students trained',    color: 'var(--color-callisto)' },
            { value: '6K+',   label: 'Teachers trained',    color: 'var(--color-nebula)' },
            { value: '2017',  label: 'Serving Canada since', color: 'var(--color-stellar)' },
          ].map(s => (
            <div>
              <div style={`font-family: var(--font-family-display); font-size: 1.75rem; font-weight: 700; color: ${s.color}; line-height: 1;`}>{s.value}</div>
              <div style="color: var(--color-dust); font-size: 0.8rem; margin-top: 0.3rem;">{s.label}</div>
            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Resources: search + filter + grid -->
  <section id="resources" style="background: var(--color-space-900); padding: 4rem 0 6rem;">
    <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">

      <p style="font-size: 0.8rem; color: var(--color-callisto); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.75rem; text-align: center;">What's available</p>
      <h2 style="font-family: var(--font-family-display); font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; text-align: center; margin: 0 0 0.75rem;">
        Everything runs in your browser
      </h2>
      <p style="color: var(--color-dust); text-align: center; max-width: 540px; margin: 0 auto 2.5rem; line-height: 1.7;">
        Powered by JupyterLite — no account, no installation. Click any resource to open it now.
      </p>

      <!-- Featured Pokémon challenge -->
      <div style="position: relative; overflow: hidden; background: linear-gradient(135deg, rgba(245,200,66,0.08) 0%, rgba(124,77,255,0.08) 100%); border: 1px solid rgba(245,200,66,0.25); border-radius: 16px; padding: 2.5rem 2.5rem 2.5rem 2rem; margin-bottom: 2.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;">
        <div aria-hidden="true" style="position: absolute; right: -40px; top: -40px; width: 250px; height: 250px; border-radius: 50%; background: radial-gradient(circle, rgba(245,200,66,0.1) 0%, transparent 70%); pointer-events: none;"></div>
        <div style="position: relative; z-index: 1; flex: 1; min-width: 260px;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(245,200,66,0.12); border: 1px solid rgba(245,200,66,0.3); border-radius: 100px; padding: 0.25rem 0.875rem; margin-bottom: 1rem;">
            <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-stellar); letter-spacing: 0.06em; text-transform: uppercase;">Featured Hackathon Challenge</span>
          </div>
          <h3 style="font-family: var(--font-family-display); font-size: clamp(1.4rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-cloud); margin: 0 0 0.75rem; letter-spacing: -0.02em;">
            Gotta catch 'em all —<br /><span style="color: var(--color-stellar);">with data science</span>
          </h3>
          <p style="color: var(--color-dust); line-height: 1.7; margin: 0 0 1.5rem; max-width: 480px; font-size: 0.95rem;">
            Explore the full Pokédex using Python and real game data. Students analyse stats, visualize type matchups, and build their own ranking models — a perennial student favourite that makes data science instantly click.
          </p>
          <a href="https://callysto.github.io/jupyterlite/lab?path=hackathon%2FPok%C3%A9mon%2Fpokemon-intro.ipynb" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-stellar); color: var(--color-space-950); text-decoration: none; font-weight: 700; font-size: 0.9rem; padding: 0.75rem 1.5rem; border-radius: 8px;">
            ▶ Try the Pokémon challenge
          </a>
        </div>
        <div aria-hidden="true" style="font-size: clamp(5rem, 10vw, 8rem); line-height: 1; user-select: none; position: relative; z-index: 1;">⚡</div>
      </div>

      <!-- Search + filter bar -->
      <div style="background: var(--color-space-800); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 0.875rem;">

        <!-- Search input -->
        <div style="position: relative; max-width: 480px;">
          <svg style="position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--color-dust);" width="15" height="15" viewBox="0 0 16 16" fill="none">
            <circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 10l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input id="search-input" type="search" placeholder="Search resources by topic, subject, or keyword…"
            style="width: 100%; background: var(--color-space-900); border: 1px solid rgba(255,255,255,0.09); border-radius: 8px; padding: 0.625rem 1rem 0.625rem 2.4rem; color: var(--color-cloud); font-size: 0.875rem; outline: none; font-family: var(--font-family-sans);" />
        </div>

        <!-- Type filters -->
        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;">
          <span style="font-size: 0.72rem; color: var(--color-dust); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 0.25rem; white-space: nowrap;">Type:</span>
          {typeFilters.map(f => (
            <button class="type-filter" data-filter={f.key}
              style={`background: ${f.key === 'all' ? 'var(--color-callisto)' : 'rgba(255,255,255,0.05)'}; color: ${f.key === 'all' ? '#fff' : 'var(--color-dust)'}; border: 1px solid ${f.key === 'all' ? 'transparent' : 'rgba(255,255,255,0.08)'}; border-radius: 100px; padding: 0.275rem 0.8rem; font-size: 0.78rem; font-weight: 500; cursor: pointer; font-family: var(--font-family-sans); white-space: nowrap;`}>
              {f.label}
            </button>
          ))}
        </div>

        <!-- Subject filters -->
        <div style="display: flex; flex-wrap: wrap; gap: 0.4rem; align-items: center;">
          <span style="font-size: 0.72rem; color: var(--color-dust); font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; margin-right: 0.25rem; white-space: nowrap;">Subject:</span>
          {subjectFilters.map(f => (
            <button class="subject-filter" data-filter={f.key}
              style={`background: ${f.key === 'all' ? 'rgba(255,255,255,0.08)' : 'rgba(255,255,255,0.05)'}; color: ${f.key === 'all' ? 'var(--color-cloud)' : 'var(--color-dust)'}; border: 1px solid ${f.key === 'all' ? 'rgba(255,255,255,0.18)' : 'rgba(255,255,255,0.07)'}; border-radius: 100px; padding: 0.275rem 0.8rem; font-size: 0.78rem; font-weight: 500; cursor: pointer; font-family: var(--font-family-sans); white-space: nowrap;`}>
              {f.label}
            </button>
          ))}
        </div>

        <p id="result-count" style="font-size: 0.78rem; color: var(--color-dust); margin: 0;">Showing {total} resources</p>
      </div>

      <!-- Resource grid -->
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.25rem;">
        {resources.map(r => {
          const tc = typeConfig[r.type] ?? { label: r.type, color: 'var(--color-dust)' };
          return (
            <a href={r.href} target="_blank" rel="noopener"
              data-resource data-type={r.type}
              data-subjects={r.subjects.join(' ')}
              data-text={`${r.title} ${r.desc}`.toLowerCase()}
              style="display: flex; flex-direction: column; background: var(--color-space-950); border: 1px solid rgba(255,255,255,0.06); border-radius: 12px; padding: 1.5rem; text-decoration: none;"
              onmouseover="this.style.borderColor='rgba(79,142,247,0.3)'"
              onmouseout="this.style.borderColor='rgba(255,255,255,0.06)'">
              <div style={`display: inline-block; font-size: 0.68rem; font-weight: 700; color: ${tc.color}; background: color-mix(in srgb, ${tc.color} 12%, transparent); border-radius: 100px; padding: 0.175rem 0.6rem; margin-bottom: 0.75rem; width: fit-content; letter-spacing: 0.04em; text-transform: uppercase;`}>
                {tc.label}
              </div>
              <h3 style="font-family: var(--font-family-display); font-size: 0.95rem; font-weight: 600; color: var(--color-cloud); margin: 0 0 0.5rem; line-height: 1.35;">
                {r.title}
              </h3>
              <p style="font-size: 0.8rem; color: var(--color-dust); line-height: 1.65; margin: 0 0 1rem; flex: 1;">
                {r.desc}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 0.3rem; margin-bottom: 0.875rem;">
                {r.subjects.filter(s => s !== 'general').map(s => (
                  <span style="font-size: 0.65rem; color: var(--color-dust); background: rgba(255,255,255,0.05); border-radius: 4px; padding: 0.1rem 0.45rem;">
                    {subjectConfig[s] ?? s}
                  </span>
                ))}
              </div>
              <div style={`font-size: 0.75rem; font-weight: 600; color: ${tc.color};`}>Open in JupyterLite →</div>
            </a>
          );
        })}
      </div>

      <!-- Empty state -->
      <div id="empty-state" hidden style="text-align: center; padding: 4rem 1.5rem; color: var(--color-dust);">
        <p style="font-size: 1.1rem; margin-bottom: 0.5rem;">No resources match your filters.</p>
        <p style="font-size: 0.875rem;">Try a different search term or clear a filter.</p>
      </div>

    </div>
  </section>

  <!-- About -->
  <section id="about" style="padding: 6rem 1.5rem; max-width: 1200px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;">
      <div>
        <p style="font-size: 0.8rem; color: var(--color-callisto); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Our mission</p>
        <h2 style="font-family: var(--font-family-display); font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 1.5rem;">
          Data literacy for every Canadian student
        </h2>
        <p style="color: var(--color-dust); line-height: 1.8; margin-bottom: 1.25rem;">
          Callysto is a free, online learning tool that helps Grades 5–12 students and teachers develop in-demand data science skills — from data analysis and visualization to coding and computational thinking.
        </p>
        <p style="color: var(--color-dust); line-height: 1.8;">
          Our interactive learning modules span every subject area and are aligned with existing curricula across Canada, so teachers can integrate them without rebuilding their lesson plans from scratch.
        </p>
        <div style="margin-top: 2rem; padding: 1.25rem 1.5rem; background: rgba(79,142,247,0.06); border-left: 3px solid var(--color-callisto); border-radius: 0 8px 8px 0;">
          <p style="color: var(--color-cloud); font-size: 0.9rem; line-height: 1.7; margin: 0; font-style: italic;">
            The name Callysto reflects our deep connection to open science: <strong style="color: var(--color-callisto);">Callisto</strong> is a moon of Jupiter, and we spell it with a "y" as a nod to <strong style="color: var(--color-nebula);">Jupyter</strong> and <strong style="color: var(--color-aurora);">Python</strong> — the open-source tools at the heart of every one of our notebooks.
          </p>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
        {[
          { icon: '🔬', label: 'Science',               desc: 'Climate, biology, physics' },
          { icon: '📐', label: 'Mathematics',           desc: 'Statistics, data, probability' },
          { icon: '🌎', label: 'Social Studies',        desc: 'Geography, history, policy' },
          { icon: '💻', label: 'Technology',            desc: 'Python, AI, computer science' },
          { icon: '📖', label: 'English',               desc: 'Text analysis, Shakespeare' },
          { icon: '🤖', label: 'Artificial Intelligence', desc: 'Generative AI, ethics' },
        ].map(subject => (
          <div style="background: var(--color-space-900); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 1.25rem;">
            <div style="font-size: 1.5rem; margin-bottom: 0.5rem;">{subject.icon}</div>
            <div style="font-family: var(--font-family-display); font-weight: 600; font-size: 0.9rem; color: var(--color-cloud); margin-bottom: 0.25rem;">{subject.label}</div>
            <div style="font-size: 0.8rem; color: var(--color-dust);">{subject.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AI section -->
  <section style="padding: 6rem 1.5rem; max-width: 1200px; margin: 0 auto;">
    <div style="background: linear-gradient(135deg, rgba(124,77,255,0.08) 0%, rgba(79,142,247,0.08) 100%); border: 1px solid rgba(124,77,255,0.2); border-radius: 16px; padding: 4rem; position: relative; overflow: hidden;">
      <div aria-hidden="true" style="position: absolute; right: -60px; top: -60px; width: 300px; height: 300px; border-radius: 50%; background: radial-gradient(circle, rgba(124,77,255,0.12) 0%, transparent 70%); pointer-events: none;"></div>
      <div style="max-width: 640px; position: relative;">
        <p style="font-size: 0.8rem; color: var(--color-nebula); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1rem;">Where we're going</p>
        <h2 style="font-family: var(--font-family-display); font-size: clamp(1.75rem, 3vw, 2.25rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 1.25rem;">
          Preparing students for an AI-enabled world
        </h2>
        <p style="color: var(--color-dust); line-height: 1.8; margin-bottom: 1.25rem;">
          Callysto's AI and Data Science course covers the full landscape — from working with data to building and training machine learning models. Critically, it includes dedicated lessons on <strong style="color: var(--color-cloud);">generative AI</strong> and <strong style="color: var(--color-cloud);">AI ethics</strong>, helping students think clearly about how these tools work and what they mean for society.
        </p>
        <p style="color: var(--color-dust); line-height: 1.8; margin-bottom: 2rem;">
          Because understanding AI isn't just a technical skill — it's a citizenship skill.
        </p>
        <a href="https://callysto.github.io/jupyterlite/lab?path=data-science-and-artificial-intelligence%2F" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-nebula); color: #fff; text-decoration: none; font-weight: 600; font-size: 0.95rem; padding: 0.75rem 1.75rem; border-radius: 8px;">
          Explore the AI course
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section style="padding: 5rem 1.5rem; background: var(--color-space-900);">
    <div style="max-width: 760px; margin: 0 auto; text-align: center;">
      <div style="font-size: 3rem; color: var(--color-callisto); opacity: 0.4; line-height: 1; margin-bottom: 1.5rem;">"</div>
      <blockquote style="font-family: var(--font-family-display); font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 500; line-height: 1.7; color: var(--color-cloud); margin: 0 0 2rem; font-style: italic;">
